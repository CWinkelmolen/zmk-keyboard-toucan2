#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NUM  1
#define NAV  2
#define FN   3

/* Vial export had a 190 ms tapping term. QMK default tap-hold behavior is
 * closest to ZMK tap-preferred, so use that for the home-row mod-taps.
 */

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <190>;
};

&lt { tapping-term-ms = <190>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp ESC  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSLH  &kp CAPS  &mt LCTRL A  &mt LALT S  &mt LGUI D  &mt LSHFT F  &kp G  &kp H  &mt RSHFT J  &mt RGUI K  &mt RALT L  &mt RCTRL SEMI  &kp SQT  &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT  &kp LA(SPACE)  &lt NUM SPACE  &kp TAB  &kp RET  &lt NAV BSPC  &lt FN DEL
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
&bootloader  &trans  &trans  &trans  &trans  &kp LS(LBKT)  &kp LS(RBKT)  &kp N7  &kp N8  &kp N9  &kp MINUS  &kp GRAVE  &trans  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &kp LBKT  &kp RBKT  &kp N4  &kp N5  &kp N6  &kp EQUAL  &kp BSLH  &trans  &trans  &trans  &trans  &trans  &kp LS(N9)  &kp LS(N0)  &kp N1  &kp N2  &kp N3  &kp KP_DOT  &kp KP_COMMA  &trans  &trans  &trans  &trans  &kp N0  &trans
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &trans  &trans  &kp LG(LS(Z))  &kp LG(V)  &kp LG(C)  &kp LG(X)  &kp LG(Z)  &trans  &trans  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp PSCRN  &trans  &trans  &studio_unlock  &trans  &trans  &trans  &trans  &kp INS  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        fn {
            display-name = "FN";
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN  &trans  &trans  &trans  &trans  &trans  &bootloader  &trans  &kp F11  &kp F4  &kp F5  &kp F6  &trans  &trans  &kp RSHFT  &kp RGUI  &kp RALT  &kp RCTRL  &trans  &trans  &kp F10  &kp F1  &kp F2  &kp F3  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MCLK  &mkp LCLK  &mkp RCLK  &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
