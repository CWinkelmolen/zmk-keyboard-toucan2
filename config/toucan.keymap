#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NUM   1
#define NAV   2
#define FN    3
#define MOUSE 4

/*
 * Layer-taps blijven op de oorspronkelijke 190 ms.
 */
&lt {
    tapping-term-ms = <190>;
};

/ {
    behaviors {
        /*
         * LEFT HOME-ROW MODS
         *
         * A = Ctrl
         * S = Alt
         * D = GUI
         * F = Shift
         *
         * Alleen toetsen van de rechterhand staan in de triggerlijst.
         * Daardoor worden snelle same-hand rolls normaal als letters getypt.
         */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                6 7 8 9 10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                39 40 41
            >;

            hold-trigger-on-release;
        };

        /*
         * RIGHT HOME-ROW MODS
         *
         * J = Shift
         * K = GUI
         * L = Alt
         * ; = Ctrl
         *
         * Alleen toetsen van de linkerhand staan in de triggerlijst.
         */
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                0 1 2 3 4 5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37 38
            >;

            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";

            bindings = <
                &kp ESC
                &kp Q
                &kp W
                &kp E
                &kp R
                &kp T
                &kp Y
                &kp U
                &kp I
                &kp O
                &kp P
                &kp BSLH

                &kp CAPS
                &hml LCTRL A
                &hml LALT S
                &hml LGUI D
                &hml LSHFT F
                &kp G
                &kp H
                &hmr RSHFT J
                &hmr RGUI K
                &hmr RALT L
                &hmr RCTRL SEMI
                &kp SQT

                &kp LSHFT
                &kp Z
                &kp X
                &kp C
                &kp V
                &kp B
                &kp N
                &kp M
                &kp COMMA
                &kp DOT
                &kp FSLH
                &kp RSHFT

                &kp LA(SPACE)
                &lt NUM SPACE
                &kp TAB
                &kp RET
                &lt NAV BSPC
                &lt FN DEL
            >;
        };

        num {
            display-name = "NUM";

            bindings = <
                &bootloader
                &trans
                &trans
                &trans
                &trans
                &kp LS(LBKT)
                &kp LS(RBKT)
                &kp N7
                &kp N8
                &kp N9
                &kp MINUS
                &kp GRAVE

                &trans
                &kp LCTRL
                &kp LALT
                &kp LGUI
                &kp LSHFT
                &kp LBKT
                &kp RBKT
                &kp N4
                &kp N5
                &kp N6
                &kp EQUAL
                &kp BSLH

                &trans
                &trans
                &trans
                &trans
                &trans
                &kp LS(N9)
                &kp LS(N0)
                &kp N1
                &kp N2
                &kp N3
                &kp KP_DOT
                &kp KP_COMMA

                &trans
                &trans
                &trans
                &trans
                &kp N0
                &trans
            >;
        };

        nav {
            display-name = "NAV";

            bindings = <
                &bt BT_SEL 0
                &bt BT_SEL 1
                &bt BT_SEL 2
                &bt BT_CLR
                &trans
                &trans
                &kp LG(LS(Z))
                &kp LG(V)
                &kp LG(C)
                &kp LG(X)
                &kp LG(Z)
                &trans

                &trans
                &kp LCTRL
                &kp LALT
                &kp LGUI
                &kp LSHFT
                &trans
                &kp LEFT
                &kp DOWN
                &kp UP
                &kp RIGHT
                &kp PSCRN
                &trans

                &trans
                &studio_unlock
                &trans
                &trans
                &trans
                &trans
                &kp INS
                &kp HOME
                &kp PG_DN
                &kp PG_UP
                &kp END
                &trans

                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
            >;
        };

        fn {
            display-name = "FN";

            bindings = <
                &trans
                &kp F12
                &kp F7
                &kp F8
                &kp F9
                &kp PSCRN
                &trans
                &trans
                &trans
                &trans
                &trans
                &bootloader

                &trans
                &kp F11
                &kp F4
                &kp F5
                &kp F6
                &trans
                &trans
                &kp RSHFT
                &kp RGUI
                &kp RALT
                &kp RCTRL
                &trans

                &trans
                &kp F10
                &kp F1
                &kp F2
                &kp F3
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
            >;
        };

        mouse {
            display-name = "MOU";

            bindings = <
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                &mkp MCLK
                &mkp LCLK
                &mkp RCLK
                &mkp LCLK
                &mkp RCLK
                &mkp MCLK
            >;
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};

